# Copy to /etc/switchboard/env (mode 0600, owned by the service user). Never commit real values.
# systemd reads this as an EnvironmentFile: keep every comment on its own line, never after a value.
SWITCHBOARD_CONFIG=/etc/switchboard/config.yaml

# Slack app (Socket Mode): bot token and app-level token with connections:write.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Ops agent engines and context, in chain order (P7). Each engine subprocess sees only its own
# credential, never the Slack tokens.

# 1st engine: an Anthropic Console API key, ideally in a workspace with a spend limit (runbook §3).
ANTHROPIC_API_KEY=
# 2nd engine: `claude setup-token` on a subscription of the agent's own (P7, runbook §4).
CLAUDE_CODE_OAUTH_TOKEN=
# 3rd engine: the directory holding the ChatGPT-plan login for Codex (runbook §5).
CODEX_HOME=/var/lib/switchboard/codex-home
# Read-only deploy key for the context repos (runbook §6).
CONTEXT_DEPLOY_KEY_PATH=/etc/switchboard/deploy_key
